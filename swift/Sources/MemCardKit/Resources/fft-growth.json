  "exp_formulas": {
    "exp_per_action": "(target_level - source_level + 10) * gained_exp_up",
    "gained_exp_up": { "without": 1, "with": 2 },
    "jp_per_action": "(source_job_level * 2 + floor(source_level / 4) + 8) * gained_jp_up",
    "gained_jp_up": { "without": 1.0, "with": 1.5 },
    "note": "Level 99 at job level 8 always yields 48 JP (72 with Gained JP Up)."
